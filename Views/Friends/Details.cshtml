@model FreindsHub.Models.Friend

<div class="container py-5">

    <div class="text-center mb-4">
        <h1 class="fw-bold">Friend Details</h1>
        <p class="text-muted">Get to know your friend better ❤️</p>
    </div>

    <div class="card details-card border-0 shadow mx-auto">

        <!-- Profile Header -->
        <div class="profile-header text-center text-white py-5">

           
            <h2 class="fw-bold mb-2">@Model.FullName</h2>

            <span class="badge rounded-pill bg-light text-dark px-3 py-2">
                @Model.FriendType
            </span>

            <p class="mt-3 mb-0">
                <i class="bi bi-geo-alt-fill me-1"></i>
                @Model.City
            </p>
        </div>

        <!-- Friend Information -->
        <div class="card-body p-4 p-md-5">

            <h5 class="fw-bold mb-4">
                <i class="bi bi-person-lines-fill me-2 text-primary"></i>
                Personal Information
            </h5>

            <div class="row g-4">

                <div class="col-md-6">
                    <div class="info-box">
                        <i class="bi bi-person-heart info-icon"></i>
                        <div>
                            <small>Nickname</small>
                            <p>@Model.NickName</p>
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="info-box">
                        <i class="bi bi-telephone-fill info-icon"></i>
                        <div>
                            <small>Phone Number</small>
                            <p>@Model.PhoneNumber</p>
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="info-box">
                        <i class="bi bi-cake2-fill info-icon"></i>
                        <div>
                            <small>Date of Birth</small>
                            <p>@Model.DateOfBirth</p>
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="info-box">
                        <i class="bi bi-geo-alt-fill info-icon"></i>
                        <div>
                            <small>City</small>
                            <p>@Model.City</p>
                        </div>
                    </div>
                </div>

            </div>

            <hr class="my-4" />

            <h5 class="fw-bold mb-4">
                <i class="bi bi-stars me-2 text-primary"></i>
                Favourites
            </h5>

            <div class="row g-4">

                <div class="col-md-6">
                    <div class="favourite-box">
                        <div class="favourite-icon food-icon">
                            <i class="bi bi-egg-fried"></i>
                        </div>

                        <div>
                            <small>Favourite Food</small>
                            <h6>@Model.FavouriteFood</h6>
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="favourite-box">
                        <div class="favourite-icon movie-icon">
                            <i class="bi bi-film"></i>
                        </div>

                        <div>
                            <small>Favourite Movie</small>
                            <h6>@Model.FavouriteMovie</h6>
                        </div>
                    </div>
                </div>

            </div>

            <!-- Action Buttons -->
            <div class="d-flex flex-wrap justify-content-center gap-3 mt-5">

                <a asp-action="Index"
                   class="btn btn-outline-secondary px-4">
                    <i class="bi bi-arrow-left me-1"></i>
                    Back to Friends
                </a>

            </div>

        </div>
    </div>
</div>

<style>
    .details-card {
        max-width: 850px;
        border-radius: 20px;
        overflow: hidden;
    }

    .profile-header {
        background: linear-gradient(135deg, #6a5af9, #a855f7);
    }

    .profile-avatar {
        width: 100px;
        height: 100px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 55px;
        background: rgba(255, 255, 255, 0.2);
        border: 3px solid rgba(255, 255, 255, 0.7);
    }

    .info-box {
        display: flex;
        align-items: center;
        gap: 15px;
        padding: 16px;
        height: 100%;
        background: #f8f9fc;
        border-radius: 12px;
    }

    .info-icon {
        font-size: 24px;
        color: #7957e8;
    }

    .info-box small,
    .favourite-box small {
        display: block;
        color: #888;
        margin-bottom: 5px;
    }

    .info-box p {
        margin: 0;
        font-weight: 600;
        overflow-wrap: anywhere;
    }

    .favourite-box {
        display: flex;
        align-items: center;
        gap: 15px;
        padding: 18px;
        border: 1px solid #eee;
        border-radius: 12px;
        height: 100%;
    }

    .favourite-icon {
        width: 50px;
        height: 50px;
        flex-shrink: 0;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 25px;
    }

    .food-icon {
        background: #fff0df;
        color: #f08a24;
    }

    .movie-icon {
        background: #eee8ff;
        color: #7957e8;
    }

    .favourite-box h6 {
        margin: 0;
        font-weight: 600;
        overflow-wrap: anywhere;
    }
</style>