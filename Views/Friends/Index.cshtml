@* //Adding a Card Style Animation *@
@model List<FreindsHub.Models.Friend>

<div class="container py-4">
    <h1 class="text-center fw-bold mb-2">Friends Hub</h1>
    <p class="text-center text-muted mb-4">
        Your friends, your memories ❤️
    </p>
    <hr class="mb-4" />
    <div class="d-flex justify-content-end mb-4">
        <a asp-controller="Friends"
           asp-action="Insert"
           class="btn add-friend-btn">
            <i class="bi bi-person-plus-fill me-2"></i>
            Add New Friend
            <i class="bi bi-arrow-right ms-2 add-arrow"></i>
        </a>
    </div>

    </div>
    <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-4 g-4">
        @foreach (var friend in Model)
        {
            <div class="col">
                <div class="card friend-card h-100 border-0 shadow-sm">

                    <div class="card-header text-center text-white py-4">
                        
                        <h5 class="fw-bold mb-1">
                            @friend.FullName
                        </h5>

                        <span class="badge rounded-pill bg-light text-dark">
                            @friend.FriendType
                        </span>
                    </div>

                    <div class="card-body">
                        <div class="friend-detail">
                            <i class="bi bi-person-heart"></i>
                            <div>
                                <small>Nickname</small>
                                <p>@friend.NickName</p>
                            </div>
                        </div>

                        <div class="friend-detail">
                            <i class="bi bi-geo-alt-fill"></i>
                            <div>
                                <small>City</small>
                                <p>@friend.City</p>
                            </div>
                        </div>

                        <div class="friend-detail">
                            <i class="bi bi-telephone-fill"></i>
                            <div>
                                <small>Phone Number</small>
                                <p>@friend.PhoneNumber</p>
                            </div>
                        </div>

                        <div class="friend-detail">
                            <i class="bi bi-cake2-fill"></i>
                            <div>
                                <small>Date of Birth</small>
                                <p>@friend.DateOfBirth</p>
                            </div>
                        </div>

                        <hr />

                        <div class="favourite-item">
                            <i class="bi bi-egg-fried"></i>
                            <span>Favourite Food</span>
                            <p>@friend.FavouriteFood</p>
                        </div>

                        <div class="favourite-item">
                            <i class="bi bi-film"></i>
                            <span>Favourite Movie</span>
                            <p>@friend.FavouriteMovie</p>
                        </div>

                        <div class="d-flex justify-content-center gap-3 mt-3 pt-3 border-top">
                            <a asp-action="Details" asp-route-id="@friend.Id"
                               class="friend-action text-primary"
                               title="View">
                                <i class="bi bi-eye-fill"></i> 
                            </a>

                            <a asp-action="Edit" asp-route-id="@friend.Id"
                               class="friend-action text-success"
                               title="Edit" >
                                <i class="bi bi-pencil-square"></i>
                            </a>

                            <a asp-action ="Delete" asp-route-id="@friend.Id"
                               class="friend-action text-danger"
                               title="Delete">
                                <i class="bi bi-trash-fill"></i>
                            </a>
                        </div>

                    </div>
                </div>
            </div>
        }
    </div>
</div>

<style>
    .add-friend-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 12px 22px;
        border: none;
        border-radius: 10px;
        background: linear-gradient(135deg, #6a5af9, #a855f7);
        color: white;
        font-size: 15px;
        font-weight: 600;
        text-decoration: none;
        box-shadow: 0 4px 12px rgba(106, 90, 249, 0.2);
        transition: all 0.3s ease;
    }

        .add-friend-btn:hover {
            color: white;
            background: linear-gradient(135deg, #5848e8, #9333ea);
            box-shadow: 0 7px 18px rgba(106, 90, 249, 0.3);
            transform: translateY(-2px);
        }

        .add-friend-btn .add-arrow {
            transition: transform 0.3s ease;
        }

        .add-friend-btn:hover .add-arrow {
            transform: translateX(4px);
        }
    .friend-card {
        border-radius: 18px;
        overflow: hidden;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

        .friend-card:hover {
            transform: translateY(-7px);
            box-shadow: 0 12px 28px rgba(0, 0, 0, 0.15) !important;
        }

        .friend-card .card-header {
            background: linear-gradient(135deg, #6a5af9, #a855f7);
            border: none;
        }

    .avatar {
        width: 70px;
        height: 70px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.2);
        border: 2px solid rgba(255, 255, 255, 0.7);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 35px;
    }

    .friend-detail {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        margin-bottom: 16px;
    }

        .friend-detail > i,
        .favourite-item > i {
            color: #7957e8;
            font-size: 19px;
            min-width: 22px;
        }

        .friend-detail small {
            color: #888;
            display: block;
            font-size: 12px;
        }

        .friend-detail p {
            margin: 2px 0 0;
            font-weight: 500;
            overflow-wrap: anywhere;
        }

    .favourite-item {
        margin-bottom: 16px;
    }

        .favourite-item span {
            color: #888;
            font-size: 12px;
            margin-left: 5px;
        }

        .favourite-item p {
            margin: 5px 0 0 28px;
            font-weight: 600;
            overflow-wrap: anywhere;
        }

    .friend-action {
        text-decoration: none !important;
        font-size: 18px;
        padding: 4px 8px;
        transition: transform 0.2s ease;
    }

        .friend-action:hover {
            text-decoration: none !important;
            transform: scale(1.15);
        }
</style>
