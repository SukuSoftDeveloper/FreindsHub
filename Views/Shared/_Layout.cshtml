<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FriendsHub</title>

    <script type="importmap"></script>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/FreindsHub.styles.css" asp-append-version="true" />

    <!-- Bootstrap Icons -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <style>
        body {
            background-color: #f8f7ff;
        }

        /* Navbar */
        .custom-navbar {
            background: linear-gradient(135deg, #6a5af9, #a855f7);
            padding: 14px 0;
            box-shadow: 0 4px 15px rgba(106, 90, 249, 0.18);
        }

            .custom-navbar .navbar-brand {
                color: white;
                font-size: 24px;
                font-weight: 700;
                letter-spacing: 0.5px;
            }

                .custom-navbar .navbar-brand:hover {
                    color: #f0eaff;
                }

            .custom-navbar .nav-link {
                color: rgba(255, 255, 255, 0.85);
                font-weight: 500;
                padding: 10px 16px !important;
                margin: 0 3px;
                border-radius: 8px;
                transition: all 0.2s ease;
            }

                .custom-navbar .nav-link:hover,
                .custom-navbar .nav-link:focus {
                    color: white;
                    background-color: rgba(255, 255, 255, 0.16);
                }

            .custom-navbar .navbar-toggler {
                border-color: rgba(255, 255, 255, 0.5);
            }

                .custom-navbar .navbar-toggler:focus {
                    box-shadow: 0 0 0 0.15rem rgba(255, 255, 255, 0.25);
                }

            .custom-navbar .navbar-toggler-icon {
                filter: brightness(0) invert(1);
            }

        /* Page background and content */
        main {
            min-height: 75vh;
        }

        /* Footer */
        .custom-footer {
            background: linear-gradient(135deg, #6a5af9, #a855f7);
            color: white;
            padding: 18px 0;
            margin-top: 30px;
        }

            .custom-footer a {
                color: #ffffff;
                text-decoration: none;
                font-weight: 500;
            }

                .custom-footer a:hover {
                    text-decoration: underline;
                    color: #f0eaff;
                }

        @@media (max-width: 576px) {
            .custom-navbar .nav-link {
                margin: 3px 0;
            }
        }
    </style>
</head>

<body>

    <!-- Navigation Bar -->
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm custom-navbar mb-4">
            <div class="container">

                <a class="navbar-brand"
                   asp-area=""
                   asp-controller="Home"
                   asp-action="Index">
                    <i class="bi bi-people-fill me-2"></i>
                    FriendsHub
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar"
                        aria-expanded="false"
                        aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse" id="mainNavbar">
                    <ul class="navbar-nav ">

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-area=""
                               asp-controller="Home"
                               asp-action="Index">
                                <i class="bi bi-house-door-fill me-1"></i>
                                Home
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-area=""
                               asp-controller="Friends"
                               asp-action="Index">
                                <i class="bi bi-people-fill me-1"></i>
                                Friends Dashboard
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-area=""
                               asp-controller="Friends"
                               asp-action="Insert">
                                <i class="bi bi-person-plus-fill me-1"></i>
                                Add Friend
                            </a>
                        </li>

                      

                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <!-- Main Content -->
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <!-- Footer -->
    <footer class="custom-footer">
        <div class="container text-center">
            <p class="mb-1">
                <i class="bi bi-heart-fill me-1"></i>
                FriendsHub — Every friendship has a story.
            </p>

            <small>
                &copy; 2026 FriendsHub |
                <a asp-area=""
                   asp-controller="Home"
                   asp-action="Privacy">
                    Privacy
                </a>
            </small>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>